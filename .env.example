APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=darfo5_hrms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Real email with Gmail (see docs/email-gmail-setup.md). Uncomment these and fill them in on the live server:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME=the.sending.address@gmail.com
# MAIL_PASSWORD=<the 16-letter App Password, not the normal Google password>
# MAIL_FROM_ADDRESS=the.sending.address@gmail.com

# Development safety: send EVERY email (login codes, approvals, announcements, memos) to this ONE address instead of the
# real people. Use it on any computer whose database holds real employees. Leave it EMPTY on the live server.
MAIL_ALWAYS_TO=

# The security code on the login and sign-up pages. Keep it true on the live server.
CAPTCHA_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CSC Form 6 (Application for Leave) — names printed on section 7 (config/leave.php)
LEAVE_FORM_TIMEZONE=Asia/Manila
LEAVE_CERTIFYING_OFFICER_NAME=
LEAVE_CERTIFYING_OFFICER_TITLE=
LEAVE_RECOMMENDING_OFFICER_NAME=
LEAVE_RECOMMENDING_OFFICER_TITLE=
LEAVE_APPROVING_OFFICIAL_NAME=
LEAVE_APPROVING_OFFICIAL_TITLE=

# Reverb TLS (optional). When both paths are set, Reverb serves wss:// itself.
# REVERB_VERIFY_TLS controls certificate verification for server-side
# broadcasts: true (system CAs), a path to a CA/self-signed cert PEM, or
# false (only acceptable when REVERB_HOST is a loopback address).
REVERB_APP_ID=your-app-id
REVERB_APP_KEY=your-app-key
REVERB_APP_SECRET=your-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Reverb TLS (optional). When both paths are set, Reverb serves wss:// itself.
# REVERB_VERIFY_TLS controls certificate verification for server-side
# broadcasts: true (system CAs), a path to a CA/self-signed cert PEM, or
# false (only acceptable when REVERB_HOST is a loopback address).
REVERB_TLS_CERT=
REVERB_TLS_KEY=
REVERB_VERIFY_TLS=true
